diff --git a/Package.swift b/Package.swift
--- a/Package.swift
+++ b/Package.swift
@@ -113,3 +113,21 @@
     ],
     swiftLanguageModes: [.v6]
 )
+
+#if os(Linux)
+// SQLCipher.swift ships an Apple XCFramework. Both GRDB targets use the
+// system module backed by libsqlcipher on Linux.
+package.dependencies.removeAll { dependency in
+    guard case let .sourceControl(_, url, _) = dependency.kind else { return false }
+    return url == "https://github.com/sqlcipher/SQLCipher.swift.git"
+}
+for target in package.targets {
+    target.dependencies = target.dependencies.map { dependency in
+        if case .productItem("SQLCipher", "SQLCipher.swift", nil, nil) = dependency {
+            return .target(name: "SQLCipher")
+        }
+        return dependency
+    }
+}
+package.targets.append(.systemLibrary(name: "SQLCipher"))
+#endif
