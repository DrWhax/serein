+    /// SignalSafe: a `Net` that talks to a local test server (Signal's mock server)
+    /// instead of a Signal environment. Testing only.
+    internal init(environment: Environment, connectionManager: ConnectionManager) {
+        self.environment = environment
+        self.asyncContext = TokioAsyncContext()
+        self.connectionManager = connectionManager
+    }
+
+    public static func localTestServer(userAgent: String, chatPort: UInt16, rootCertificateDer: Data) -> Net {
+        let handle = rootCertificateDer.withUnsafeBorrowedBuffer { der in
+            failOnError {
+                try invokeFnReturningValueByPointer(.init()) {
+                    signal_testing_connection_manager_new_local_override_for_ffi(
+                        $0, userAgent, chatPort, 9, 9, 9, der, 2
+                    )
+                }
+            }
+        }
+        return Net(environment: .staging, connectionManager: ConnectionManager(owned: NonNull(handle)!))
+    }
+
