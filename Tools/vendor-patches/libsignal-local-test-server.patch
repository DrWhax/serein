+/// SignalSafe: FFI-exported variant of `TESTING_ConnectionManager_newLocalOverride`
+/// (which is Node-only) so Swift integration tests can talk to the mock server.
+#[bridge_fn(jni = false, node = false)]
+fn TESTING_ConnectionManager_newLocalOverrideForFfi(
+    userAgent: String,
+    chatPort: u16,
+    cdsiPort: u16,
+    svr2Port: u16,
+    svrBPort: u16,
+    rootCertificateDer: &[u8],
+    httpVersion: u8,
+) -> ConnectionManager {
+    let nz = |p: u16| NonZeroU16::new(p).expect("non-zero port");
+    let ports = net_env::LocalhostEnvPortConfig {
+        chat_port: nz(chatPort),
+        cdsi_port: nz(cdsiPort),
+        svr2_port: nz(svr2Port),
+        svrb_port: nz(svrBPort),
+    };
+    let http_version = match httpVersion {
+        1 => HttpVersion::Http1_1,
+        2 => HttpVersion::Http2,
+        _ => panic!("invalid HTTP version {httpVersion}"),
+    };
+    let env = net_env::localhost_test_env_with_ports(ports, rootCertificateDer, http_version);
+    ConnectionManager::new_from_static_environment(
+        env,
+        userAgent.as_str(),
+        Default::default(),
+        BuildVariant::Production,
+    )
+}
