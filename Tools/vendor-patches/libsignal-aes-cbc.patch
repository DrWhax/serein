index 0000000..82d46d4
--- /dev/null
+++ b/swift/Sources/LibSignalClient/Aes256Cbc.swift
@@ -0,0 +1,38 @@
+//
+// Copyright 2026 SignalSafe. SPDX-License-Identifier: AGPL-3.0-only
+// (SignalSafe addition: exposes signal_crypto's AES-256-CBC to Swift.)
+//
+
+import Foundation
+import SignalFfi
+
+/// AES-256-CBC with PKCS#7 padding. Not authenticated: callers must verify a MAC
+/// over the IV and ciphertext before decrypting.
+public enum Aes256Cbc {
+    public static let keyLength = 32
+    public static let ivLength = 16
+
+    public static func encrypt<K: ContiguousBytes, I: ContiguousBytes, P: ContiguousBytes>(
+        _ plaintext: P, key: K, iv: I
+    ) throws -> Data {
+        try key.withUnsafeBorrowedBuffer { k in
+            try iv.withUnsafeBorrowedBuffer { v in
+                try plaintext.withUnsafeBorrowedBuffer { p in
+                    try invokeFnReturningData { signal_aes256_cbc_encrypt($0, k, v, p) }
+                }
+            }
+        }
+    }
+
+    public static func decrypt<K: ContiguousBytes, I: ContiguousBytes, C: ContiguousBytes>(
+        _ ciphertext: C, key: K, iv: I
+    ) throws -> Data {
+        try key.withUnsafeBorrowedBuffer { k in
+            try iv.withUnsafeBorrowedBuffer { v in
+                try ciphertext.withUnsafeBorrowedBuffer { c in
+                    try invokeFnReturningData { signal_aes256_cbc_decrypt($0, k, v, c) }
+                }
+            }
+        }
+    }
+}
