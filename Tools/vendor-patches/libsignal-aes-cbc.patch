+/// AES-256-CBC with PKCS#7 padding (provisioning envelopes, attachments).
+/// Exported for SignalSafe's Swift client only.
+#[bridge_fn(jni = false, node = false)]
+fn Aes256Cbc_Encrypt(key: &[u8], iv: &[u8], plaintext: &[u8]) -> Result<Vec<u8>> {
+    signal_crypto::aes_256_cbc_encrypt(plaintext, key, iv).map_err(|_| Error::InvalidKeySize)
+}
+
+#[bridge_fn(jni = false, node = false)]
+fn Aes256Cbc_Decrypt(key: &[u8], iv: &[u8], ciphertext: &[u8]) -> Result<Vec<u8>> {
+    signal_crypto::aes_256_cbc_decrypt(ciphertext, key, iv).map_err(|e| match e {
+        signal_crypto::DecryptionError::BadKeyOrIv => Error::InvalidKeySize,
+        _ => Error::InvalidInputSize,
+    })
+}
